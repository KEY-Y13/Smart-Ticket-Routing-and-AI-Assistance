# Copy locally only when configuration is needed. No API calls are enabled.
SMARTTICKET_ENV=development
SMARTTICKET_CLASSIFIER_MANIFEST=
# Only set an approved governance package path after a real review and explicit deployment.
SMARTTICKET_ARTIFACT_ROOT=artifacts
# Compose uses its own Linux path, separately from the Windows classifier path.
# SMARTTICKET_DOCKER_CLASSIFIER_MANIFEST=/app/artifacts/governance/releases/ACTUAL_PACKAGE/manifest.json
SMARTTICKET_LLM_ENABLED=false
SMARTTICKET_LLM_CALL_BUDGET=0
# Alibaba Cloud Bailian, Beijing region. The key must belong to the endpoint region.
SMARTTICKET_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTTICKET_LLM_MODEL=qwen-plus
# Put the Bailian key here locally; DASHSCOPE_API_KEY is also supported.
# SMARTTICKET_LLM_API_KEY=
# Preferred workspace endpoint, if available in your Bailian console:
# SMARTTICKET_LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Generate a private 32+ character retrieval secret, shared only by API and local model service.
# SMARTTICKET_RETRIEVAL_SECRET=
SMARTTICKET_RETRIEVAL_URL=http://127.0.0.1:8011
# Configure only after reviewing SQL and explicitly applying it to the dedicated new database.
# SMARTTICKET_DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/smartticket_ai
# SMARTTICKET_JWT_SECRET=GENERATE_A_NEW_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# SMARTTICKET_TOKEN_MINUTES=30
